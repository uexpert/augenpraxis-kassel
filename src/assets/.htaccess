<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Always revalidate the SPA entry document so users pick up the latest hashed bundles.
  <FilesMatch "^(index\.html|service-worker\.js|ngsw-worker\.js|ngsw\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed Angular bundles (filenames contain an 8+ char content hash) — safe to cache forever.
  <FilesMatch "\.[0-9a-fA-F]{8,}\.(js|css|mjs|map|woff2?|ttf|eot|otf|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Unhashed assets under /assets/ (images, legacy CSS/JS) — always revalidate via ETag/Last-Modified.
<IfModule mod_headers.c>
  <FilesMatch "^.*$">
    <If "%{REQUEST_URI} =~ m#^/assets/#">
      Header set Cache-Control "no-cache, must-revalidate"
    </If>
  </FilesMatch>
</IfModule>

